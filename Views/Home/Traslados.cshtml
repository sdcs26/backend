@{
    ViewData["Title"] = "Traslados";
    Layout = "_Administrador";
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode/build/jwt-decode.min.js"></script>
    <title>Hacer Traslados</title>
</head>

<body class="bg-gradient-primary">

    <div class="container">

        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <div>
                    <div class="p-5">
                        <!-- Nested Row within Card Body -->

                        <div class="text-center">
                            <h1 class="h4 text-gray-900 mb-4">Hacer Traslado</h1>
                        </div>
                        <form class="user" onsubmit="trasladarSemilla(); return false;">

                          
                            <div class="form-group">
                                <h5>Ubicación</h5>
                                <select class="form-control" id="ubicacionLetra" required>
                                    <option value="" disabled selected>Letra (A-Z)</option>
                                </select>
                                <br />
                                <select class="form-control" id="ubicacionNumero1" required>
                                    <option value="" disabled selected>01 o 02</option>
                                    <option value="01">01</option>
                                    <option value="02">02</option>
                                </select>
                                <br />
                                <select class="form-control" id="ubicacionNumero2" required>
                                    <option value="" disabled selected>Altura (10-70)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <input class="form-control form-control-user" placeholder="Id de Usuario" type="number" id="idUsuario" required>
                            </div>
                            <hr>
                            <button class="btn btn-success btn-user btn-block" type="submit">
                                Registrar
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Content/js/sb-admin-2.min.js"></script>

</body>
</html>
