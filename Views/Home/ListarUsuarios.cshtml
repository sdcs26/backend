@{
    ViewData["Title"] = "Listar Usuarios";
    Layout = "_Administrador";
}
<script src="https://cdn.jsdelivr.net/npm/jwt-decode/build/jwt-decode.min.js"></script>
<p>
    <a class="d-none d-sm-inline-block btn btn-sm btn-success shadow-sm" asp-area="" asp-controller="Home" asp-action="LoginExitoso">Home</a>
</p>

<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-success">Usuarios</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Correo Electrónico</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="usuariosTableBody">
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

