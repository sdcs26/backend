@{
    ViewData["Title"] = "Login Exitoso";
    Layout = "_Administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Usuario</title>
</head>
<body class="bg-gradient-primary">

    <div class="container">

        <div class="card o-hidden border-0 shadow-lg my-5">
            <div class="card-body p-0">
                <div>
                    <div class="p-5">
                        
                        <div class="text-center">
                            <h1 class="h4 text-gray-900 mb-4">Registrar Usuarios</h1>
                        </div>
                        <form class="user" onsubmit="crearUsuario(); return false;">
                            <div class="form-group row" asp-controller="Cuenta" asp-action="RegistroUser" method="post">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <input class="form-control form-control-user" placeholder="Nombre" type="text" id="nombre" name="nombre" required>
                                </div>
                                <div class="col-sm-6">
                                    <input class="form-control form-control-user" placeholder="Apellido" type="text" id="apellido" name="apellido" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <input class="form-control form-control-user" placeholder="Correo" type="email" id="correo" name="correo" required>
                            </div>
                            <div class="form-group">
                                <input class="form-control form-control-user" placeholder="Contraseña" type="password" id="contrasena" name="contrasena" required>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <input class="form-control form-control-user" placeholder="Numero de Documento" type="number" id="numerodocumento" name="numerodocumento" required>
                                </div>
                                <div class="col-sm-6">
                                    <input class="form-control form-control-user" placeholder="Rol" type="number" id="idrol" name="idrol" required>
                                </div>
                            </div>
                            <hr>
                            <button class="btn btn-success btn-user btn-block" type="submit">
                                Registrar
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/Content/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Content/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Content/js/sb-admin-2.min.js"></script>

</body>
</html>



